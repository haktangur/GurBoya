<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · GürBoya</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header><a class="brand" asp-page="/Index">GürBoya<span>Boya ve hırdavat</span></a><nav aria-label="Ana menü">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-page="/Products/Index">Ürünler ve stok</a><a asp-page="/Sales/Index">Satışlar</a><a asp-page="/Reports/Index">Raporlar</a><a asp-page="/Account/Password">Şifre</a>
        <form method="post" asp-page="/Account/Logout"><button class="secondary">Çıkış</button></form>
    }
    else { <a asp-page="/Account/Login">Giriş yap</a> }
    </nav></header>
    <main>@RenderBody()</main>
    <footer>GürBoya · Mağaza yönetimi</footer>
</body>
</html>
