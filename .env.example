# Copy to .env and set a unique password before starting.
# This is the initialization/admin account, not the future application account.
POSTGRES_DB=gurboya
POSTGRES_USER=gurboya_admin
# Intentionally empty: Compose rejects missing/empty passwords.
POSTGRES_PASSWORD=
# F1-B: use three different passwords. Required by compose.app.yaml only.
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
WEB_PORT=5080

# Used only by the explicit admin creation command, never by the web service.
ADMIN_PASSWORD=
